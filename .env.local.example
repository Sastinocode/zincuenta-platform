# Copiar a .env.local y rellenar con los valores del proyecto Supabase
# (Sebas gestiona estos valores; ver docs/02_ARQUITECTURA.md §6)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo se usa en Route Handlers server-side (API pantalla, seeds).
# NUNCA exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
